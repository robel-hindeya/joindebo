# Postgres connection. During development this is the Supabase project
# (Settings > Database > Connection string > Session pooler). On the VPS it
# becomes the local Postgres URL. Nothing else in the code is Supabase-specific.
DATABASE_URL=postgresql://postgres.oavipgttrrqeabtlgmia:[PASSWORD]@aws-1-eu-central-1.pooler.supabase.com:5432/postgres

# local, staging or production. Production refuses DEV_SMS.
APP_ENV=local

# API
API_PORT=4000
# Long random strings, different per environment.
JWT_ACCESS_SECRET=change-me
QR_SIGNING_SECRET=change-me
# Encrypts admin authenticator secrets: 32 random bytes, base64
# (node -e "console.log(require('crypto').randomBytes(32).toString('base64'))").
ADMIN_TOTP_KEY=change-me

# Shown only in staging; never set in production.
SEED_ALLOWED=true

# SMS through AfroMessage (https://www.afromessage.com/developers). Leave SMS_PROVIDER empty to keep
# messages in tc.sms_outbox only (local development). Production requires afromessage.
SMS_PROVIDER=
AFROMESSAGE_TOKEN=
# Your verified sender name; empty uses AfroMessage's default (beta testing only).
AFROMESSAGE_SENDER=
# Only if the account has more than one short code.
AFROMESSAGE_IDENTIFIER=

# Development only: keep SMS codes in tc.sms_outbox and show them at /api/v1/dev/sms.
# Never set in production.
DEV_SMS=true
