# /opt/temelash/.env on the VPS. Never commit the real file.

# Caddy
SITE_DOMAIN=staging.example.com
ACME_EMAIL=you@example.com
# Staging password: generate the hash on the server with
#   docker run --rm caddy:2.8-alpine caddy hash-password --plaintext '<password>'
# and wrap it in single quotes here (bcrypt hashes contain $).
STAGING_USER=temelash
STAGING_PASSWORD_HASH='$2a$14$replace-me'

# API (same names as the root .env.example)
APP_ENV=staging
DATABASE_URL=postgresql://tc_api.oavipgttrrqeabtlgmia:[PASSWORD]@aws-1-eu-central-1.pooler.supabase.com:5432/postgres
API_PORT=4000
JWT_ACCESS_SECRET=change-me
QR_SIGNING_SECRET=change-me
# Encrypts admin authenticator secrets: 32 random bytes, base64
# (node -e "console.log(require('crypto').randomBytes(32).toString('base64'))").
ADMIN_TOTP_KEY=change-me

# SMS through AfroMessage (https://www.afromessage.com/developers). Leave SMS_PROVIDER empty to keep
# messages in tc.sms_outbox only (local development). Production requires afromessage.
SMS_PROVIDER=
AFROMESSAGE_TOKEN=
# Your verified sender name; empty uses AfroMessage's default (beta testing only).
AFROMESSAGE_SENDER=
# Only if the account has more than one short code.
AFROMESSAGE_IDENTIFIER=

# Staging only: also keeps codes readable at /api/v1/dev/sms (behind the staging
# password), useful for test phones. Remove for production.
DEV_SMS=true
