{
  "name": "@temelash/db",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "tsx src/migrate.ts",
    "seed": "tsx src/seed.ts",
    "test": "vitest run",
    "seed:staff": "tsx src/seed-staff.ts",
    "seed:example": "tsx --env-file=../../.env src/seed-example.ts"
  },
  "dependencies": {
    "postgres": "^3.4.5",
    "@node-rs/argon2": "^2.2.2"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
